# ===== LLM Providers (DO NOT COMMIT REAL KEYS) =====
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=
# MiniMax — Anthropic-compatible endpoint at /anthropic path
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/anthropic

# ===== Internal services =====
# 问财 EvalOps 后端(内网),仅后端可见,前端永不暴露
IWENCAI_BASE_URL=
IWENCAI_VERIFY_SSL=false

# ===== Paths =====
# 评测 Skill 协议树根目录(read-only),三类 family 都在这下面
SKILLS_ROOT=../skills
# 测试集 seed 目录
TESTSETS_ROOT=../数据测试集
# SQLite 路径
DB_PATH=./data/fin_evalops.db

# ===== Web =====
# Comma-separated list of allowed origins for browser fetch.
# Local dev:  http://localhost:5173
# Prod:       https://shuaiwang888.github.io  (GitHub Pages frontend)
# Set both when running both environments; Space will pick whichever is set.
CORS_ORIGINS=http://localhost:5173,https://shuaiwang888.github.io
# Required for POST /api/admin/persistence/push and /pull. Generate a long,
# random value and send it in the X-Admin-Token request header.
ADMIN_API_TOKEN=
# Default judge model for new runs. Must match a key in
# backend/app/services/llm_client.py:MODELS
# Common values: minimax-3 (default) | minimax-2.5 | claude-sonnet-4-6 | gpt-4o | qwen-plus
DEFAULT_JUDGE_MODEL=minimax-3

# ===== Hugging Face persistence =====
# Set these to persist the SQLite DB across container restarts/sleeps
# when deployed on a HF Space. Leave blank for local dev (DB stays on disk).
# HF_TOKEN    : https://huggingface.co/settings/tokens  (write scope)
# HF_NAMESPACE: your HF username or org, e.g. "shuaiwang888"
# HF_DATASET_REPO: any name; the Space will create it on first push
HF_TOKEN=
HF_NAMESPACE=
HF_DATASET_REPO=fin-evalops-db
# Background flush interval in seconds (0 disables; default 300s = 5 min)
HF_PUSH_INTERVAL=300
