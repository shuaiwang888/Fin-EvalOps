          "input": "{\n  \"code\": \"# 处理数据：计算K线关键要素（实体、上影线、下影线、振幅），并定位2026-04-29当日形态\\nimport pandas as pd\\nimport numpy as np\\nimport plotly.graph_objects as go\\n\\n# df 已在环境中\\n\\ndf_k = df.copy()\\n# 统一列名\\ncol_map = {\\n    '开盘价:前复权(元)': 'open',\\n    '最高价:前复权(元)': 'high',\\n    '最低价:前复权(元)': 'low',\\n    '收盘价:前复权(元)': 'close',\\n    '成交量(股)': 'volume',\\n    'date': 'date'\\n}\\nfor k,v in col_map.items():\\n    if k in df_k.columns:\\n        df_k = df_k.rename(columns={k:v})\\n\\ndf_k['date'] = pd.to_datetime(df_k['date'])\\ndf_k = df_k.sort_values('date').set_index('date')\\n\\n# 计算K线结构\\nrng = (df_k['high'] - df_k['low']).replace(0, np.nan)\\n\\ndf_k['body'] = (df_k['close'] - df_k['open']).abs()\\ndf_k['range'] = rng\\n\\ndf_k['upper_shadow'] = df_k['high'] - df_k[['open','close']].max(axis=1)\\ndf_k['lower_shadow'] = df_k[['open','close']].min(axis=1) - df_k['low']\\n\\ndf_k['body_pct_of_range'] = (df_k['body'] / df_k['range'])\\n\\ndf_k['is_bull'] = df_k['close'] > df_k['open']\\n\\n# 均线（用于判断所处趋势）\\nfor n in [5,10,20,60]:\\n    df_k[f'ma{n}'] = df_k['close'].rolling(n).mean()\\n\\n# 取目标日\\ntarget = pd.Timestamp('2026-04-29')\\nrow = df_k.loc[target]\\n\\n# 近20日高低，用于判断压力/支撑\\nwindow = 20\\nrecent_high_20 = df_k['high'].rolling(window).max().loc[target]\\nrecent_low_20 = df_k['low'].rolling(window).min().loc[target]\\n\\nsummary = pd.DataFrame({\\n    '指标': ['开盘', '最高', '最低', '收盘', '成交量(股)', '实体(收-开)', '上影线', '下影线', '振幅(高-低)', '收盘相对MA5', '收盘相对MA10', '收盘相对MA20'],\\n    '数值': [\\n        float(row['open']), float(row['high']), float(row['low']), float(row['close']), float(row['volume']),\\n        float(row['close']-row['open']), float(row['upper_shadow']), float(row['lower_shadow']), float(row['high']-row['low']),\\n        float(row['close']-df_k.loc[target,'ma5']) if pd.notna(df_k.loc[target,'ma5']) else np.nan,\\n        float(row['close']-df_k.loc[target,'ma10']) if pd.notna(df_k.loc[target,'ma10']) else np.nan,\\n        float(row['close']-df_k.loc[target,'ma20']) if pd.notna(df_k.loc[target,'ma20']) else np.nan,\\n    ]\\n})\\n\\n# 做一个近30个交易日K线图（含MA）\\nplot_df = df_k.loc[target - pd.Timedelta(days=60):target + pd.Timedelta(days=10)].copy()\\n\\nfig = go.Figure(data=[go.Candlestick(\\n    x=plot_df.index,\\n    open=plot_df['open'],\\n    high=plot_df['high'],\\n    low=plot_df['low'],\\n    close=plot_df['close'],\\n    name='日K'\\n)])\\nfor n,color in [(5,'#1f77b4'),(10,'#ff7f0e'),(20,'#2ca02c')]:\\n    fig.add_trace(go.Scatter(x=plot_df.index, y=plot_df[f'ma{n}'], mode='lines', name=f'MA{n}', line=dict(width=1,color=color)))\\n\\n# 标注目标日\\nfig.add_vline(x=target, line_width=1, line_dash='dash', line_color='red')\\nfig.update_layout(\\n    title='安杰思：目标日前后日K（含MA）',\\n    xaxis_title='日期',\\n    yaxis_title='价格(前复权, 元)',\\n    legend=dict(orientation='h', yanchor='bottom', y=-0.25, xanchor='center', x=0.5),\\n    margin=dict(l=40,r=20,t=50,b=60),\\n    height=520\\n)\\n\\nsummary, recent_high_20, recent_low_20, fig\"\n}",
