# Backend API base URL (no trailing slash).
# Local dev: leave empty to use the Vite proxy (which forwards /api to localhost:8000).
# Prod (当前部署的 HF Space 后端): https://appqqq-fin-evalops-v2.hf.space
# Set as a GitHub Actions repository secret (VITE_API_BASE) before running
# the deploy workflow; the URL gets baked into the JS bundle at build time.
VITE_API_BASE=

# Only set when deploying to a GitHub Pages sub-path, e.g. "/Fin-EvalOps/".
# Local dev should leave empty.
VITE_BASE_PATH=/
