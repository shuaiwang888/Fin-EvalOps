# Backend API base URL (no trailing slash).
# Local dev: leave empty to use the Vite proxy (which forwards /api to localhost:8000).
# Prod: https://<your-app>.onrender.com
VITE_API_BASE=

# Only set when deploying to a GitHub Pages sub-path, e.g. "/Fin-EvalOps/".
# Local dev should leave empty.
VITE_BASE_PATH=/
