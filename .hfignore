# Files NOT to sync to the HF Dataset repo (only the DB file is uploaded
# by persistence.py, but this guard catches accidental manual uploads).
.git/
__pycache__/
*.pyc
*.log
.DS_Store
backend/data/*.db-snap
backend/data/*.db-tmp

# Test data sources — NOT shipped to the Space. Tests are uploaded via the
# web UI's "导入 JSON" button or `POST /api/testsets/import-file`, not bundled
# in the Docker image. (Push mistake on 2026-07-01: whole 数据测试集/ tree
# went to the Space and had to be surgically deleted afterwards.)
数据测试集/
*.jsonl
*.jsonl.gz

# Local smoke-test fixture generated by convert_part06.py workflow
_*/_smoke_*.json
